<div class="agent-list"><h3>Agents</h3><% [['scout', 'thinking', 'reading 41 files', '1m'], ['planner', 'thinking', 'drafting the migration', '12s'], ['reviewer', 'online', 'waiting for a diff', nil], ['packager', 'away', 'last ran 6m ago', nil], ['publisher', 'offline', 'not started', nil]].each do |name, state, status, time| %><button type="button" data-action="gallery#agent" aria-pressed="<%= name == 'planner' %>"><%= render 'presence', name: name, state: state, size: 32 %><span><strong><%= name %></strong><small><%= status %></small></span><time><%= time %></time></button><% end %></div>
