<%= tag.main class: 'editor-shell site-shell', data: studio_data(editor: true) do %>
  <header class="editor-header"><a href="/">← <span>blobatar</span></a><span>editor</span></header>
  <div class="editor-grid"><div class="editor-preview"><div class="editor-name-row"><label for="editor-name">name</label><span class="name-blank"><span data-studio-target="measure" aria-hidden="true"><%= @name.presence || 'someone' %></span><input id="editor-name" value="<%= @name %>" placeholder="someone" size="1" autocomplete="off" spellcheck="false" data-studio-target="name" data-action="input->studio#name"></span><button type="button" class="icon-button" aria-label="Shuffle name" data-action="studio#shuffle"><%= studio_icon(:shuffle) %></button></div>
    <div class="editor-face"><%= blobatar_tag @name, **@options.symbolize_keys, expression: @expression, animate: @motion, id: 'studio-preview', title: "Blobatar for #{@name}", data: { studio_target: 'preview' } %></div>
    <div class="crowd-preview"><span>other names, same config</span><div><% SiteHelper::NAMES.values_at(0, 5, 10, 15, 20, 25, 30).each do |name| %><button type="button" title="<%= name %>" aria-label="Preview <%= name %>" data-action="studio#other" data-name="<%= name %>"><span data-studio-target="tile" data-kind="crowd" data-value="<%= name %>"><%= Blobatar::Rails::Renderer.svg(name, @options).html_safe %></span></button><% end %></div></div>
    <div class="motion-row"><span>motion</span><div class="segments" role="group" aria-label="Motion"><% %w[none hover always].each do |mode| %><button type="button" data-motion="<%= mode %>" data-action="studio#motion" aria-pressed="<%= (@motion || 'none').to_s == mode %>"><%= mode %></button><% end %></div></div>
  </div>
  <div class="editor-output"><%= render 'code', editor: true %><%= render 'install' %></div>
  <aside class="editor-panel" aria-label="Trait editor"><div class="panel-heading"><span data-studio-target="count">nothing pinned</span><button type="button" class="text-button" data-action="studio#reset" data-studio-target="reset" disabled>unpin all</button></div>
    <section class="trait-group"><h2>shape</h2><%= render 'shapes' %><p class="selection-note" data-studio-target="shapeNote"></p></section>
    <% %w[body eyes color decoration].each do |group| %><section class="trait-group" data-group="<%= group %>"><h2><%= group %></h2>
      <% if group == 'color' %><div class="tone-picker"><div class="axis-heading"><span>tone</span><span class="muted">choose any of these</span></div><div class="tone-grid" role="group" aria-label="Tone"><% { auto: nil }.merge(SiteHelper::TONES).each do |tone, value| %><button type="button" class="tone-tile" data-action="studio#tone" data-tone="<%= tone %>" data-value="<%= value %>" aria-pressed="<%= value.nil? ? @pinned['tone'].nil? : Array(@pinned['tone']).include?(value) %>"><span class="tone-swatch" data-studio-target="swatch" data-value="<%= value %>"></span><span><%= tone %></span></button><% end %></div><p class="selection-note" data-studio-target="toneNote"></p></div><% end %>
      <% SiteHelper::AXES.select { |axis| axis[:group] == group }.each do |axis| %><div class="axis" data-axis-row="<%= axis[:key] %>" data-when="<%= Array(axis[:when]).join(' ') %>"><div class="axis-heading"><label for="axis-<%= axis[:key] %>"><%= axis[:label] %></label><output for="axis-<%= axis[:key] %>" data-axis-output="<%= axis[:key] %>"><%= @reader.value(axis[:key]).round(3) %></output></div><div class="axis-control"><input id="axis-<%= axis[:key] %>" type="range" min="0" max="<%= axis[:bands] ? axis[:bands] - 1 : 0.999 %>" step="<%= axis[:bands] ? 1 : 0.001 %>" value="<%= axis[:bands] ? (@reader.value(axis[:key]) * axis[:bands]).floor : @reader.value(axis[:key]).round(3) %>" data-axis="<%= axis[:key] %>" data-bands="<%= axis[:bands] %>" data-action="input->studio#axis"><button type="button" class="pin-button icon-button" data-pin="<%= axis[:key] %>" data-action="studio#pin" aria-label="Pin <%= group %> <%= axis[:label] %>" aria-pressed="false" title="Pin this axis"><%= studio_icon(:lock) %></button></div><small class="axis-unavailable"><%= Array(axis[:when]).join('/') %> only</small></div><% end %>
    </section><% end %>
  </aside></div><p class="sr-only" role="status" aria-live="polite" data-studio-target="status"></p>
<% end %>
