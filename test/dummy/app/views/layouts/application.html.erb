<!DOCTYPE html>
<html lang="en">
  <head>
    <title>blobatar-rails / Rails + Hotwire</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag(controller_name == "site" ? "site" : "application", "blobatar", "data-turbo-track": "reload") %>
    <%= javascript_importmap_tags %>
  </head>
  <body><%= yield %></body>
</html>
